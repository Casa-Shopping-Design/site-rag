# URL publica usada em metadata, sitemap e robots. No teste, o endereco da
# Vercel (https://<projeto>.vercel.app). Fora do dominio oficial o site sai com noindex.
# Vazio na Vercel: usa o endereco de producao do projeto.
NEXT_PUBLIC_SITE_URL=https://casashoppingdesign.com.br

# Supabase (Settings > API). A chave publica e a unica que o site usa.
# A service_role NAO entra aqui: ela fica so na ingestao.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Modelo do assistente (fica so no servidor)
OPENAI_API_KEY=
MODELO_CHAT=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-small
OPENAI_BASE_URL=
