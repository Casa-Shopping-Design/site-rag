# Conexao direta ao Postgres do Supabase (Settings > Database > Connection string,
# modo session do pooler). Este arquivo fica so na maquina de quem faz a ingestao.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=

# Identificador fixo da galeria na base (id_proprietario da biblioteca).
# Gere uma vez com: python -c "import uuid; print(uuid.uuid4())" e nao troque mais.
SCD_ID_GALERIA=

RAG_MODELO_EMBEDDING=text-embedding-3-small
RAG_DIMENSOES_EMBEDDING=1536
RAG_FTS_IDIOMA=portuguese
RAG_STORAGE_TIPO=local
RAG_STORAGE_CAMINHO=./ingestao/arquivos
RAG_MONITORAR_USO=false
